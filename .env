# Committed defaults — non-secret only.
# Real secrets (RESEND_API_KEY) belong in Vercel project settings or .env.local.
# When RESEND_API_KEY is unset the contact/quote/careers forms log submissions
# to the server console instead of sending email — the build still deploys cleanly.

NEXT_PUBLIC_SITE_URL=https://www.randbglobalsecurity.com
CONTACT_TO_EMAIL=info@randbglobalsecurity.com
CONTACT_FROM_EMAIL=R&B Global Security <onboarding@resend.dev>
RESEND_API_KEY=

# Careers applications currently route here for testing.
# Switch to info@randbglobalsecurity.com when ready to go live.
CAREERS_TO_EMAIL=wilform.thomas@gmail.com

# Absolute URL to the logo shown in transactional emails. www.randbglobalsecurity.com
# isn't resolving yet (DNS not pointed at Vercel), so this defaults to the Vercel
# deployment URL in code. Set this once the custom domain is live and serving traffic.
EMAIL_LOGO_URL=
